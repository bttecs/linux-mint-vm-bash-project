# Required environment variables for start-node-app.sh
# Copy this file, fill in real values, and export before running:
#
#   export DB_USER=youruser
#   export DB_PWD=yourpassword
#   sudo -E ./scripts/start-node-app.sh app-logs
#
# Never commit a .env file with real values.

DB_USER=
DB_PWD=

# Optional — defaults to "dev" if not set
APP_ENV=dev
